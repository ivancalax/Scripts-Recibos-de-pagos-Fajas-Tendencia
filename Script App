// ==========================================
// MÓDULO EXCLUSIVO PARA RECIBOS DE UTILIDADES (Actualizado por Columna K)
// ==========================================

function obtenerDatosUtilidadesDeFila(fila, textoPeriodo) {
  return {
    trabajador: fila[0],                    // Columna A (0): Trabajador
    cedula: fila[1],                        // Columna B (1): Cédula de Identidad
    fechaIngreso: formatearFecha(fila[2]),  // Columna C (2): Fecha de Ingreso
    cargo: fila[3],                         // Columna D (3): Cargo
    
    salarioDiario: formatearMoneda(fila[10]),       // K (10): Salario Diario en Bs
    mesesCumplidos: formatearCantidad(fila[11]),    // L (11): Meses Cumplidos
    diasUtilidades: formatearCantidad(fila[12]),    // M (12): Días de Utilidades
    utilidadAsig: formatearMoneda(fila[14]),        // O (14): Asignación en Bs
    incesBs: formatearMoneda(fila[16]),             // Q (16): Retención INCES Bs
    totalPagar: formatearMoneda(fila[26]),          // AA (26): Total a Pagar Bs
    
    textoPeriodo: textoPeriodo                      // Ej: EJERCICIO FISCAL 2026
  };
}

function reemplazarEtiquetasUtilidades(body, datos) {
  body.replaceText("<<TRABAJADOR>>", datos.trabajador); 
  body.replaceText("<<CEDULA>>", datos.cedula || ""); 
  body.replaceText("<<FECHA_INGRESO>>", datos.fechaIngreso); 
  body.replaceText("<<CARGO>>", datos.cargo); 
  body.replaceText("<<AÑO_EN_CURSO>>", datos.textoPeriodo); 
  
  // Reemplazo de las nuevas etiquetas específicas de utilidades
  body.replaceText("<<SALARIO_DIA>>", datos.salarioDiario); 
  body.replaceText("<<MESES_CUMP>>", datos.mesesCumplidos);       
  body.replaceText("<<DIAS_UTILIDAD>>", datos.diasUtilidades);       
  body.replaceText("<<UTILIDAD_ASIG>>", datos.utilidadAsig);   
  body.replaceText("<<TOTAL_UTILIDAD>>", datos.utilidadAsig);   
  body.replaceText("<<DED_INCES>>", datos.incesBs);                
  body.replaceText("<<TOTAL_PAGAR>>", datos.totalPagar);
  
  // Compatibilidad con etiquetas heredadas por si tu plantilla las usa
  body.replaceText("<<SUELDO>>", datos.salarioDiario);
  body.replaceText("<<DIA_LAB>>", datos.mesesCumplidos);
  body.replaceText("<<ASIG_DIAS>>", "0,00"); 
  body.replaceText("<<DIA_DES>>", datos.diasUtilidades);       
  body.replaceText("<<ASIG_DESC>>", datos.utilidadAsig);   
  body.replaceText("<<CANT_HED>>", "0"); body.replaceText("<<HED>>", "0,00");
  body.replaceText("<<CANT_HEN>>", "0"); body.replaceText("<<HEN>>", "0,00");
  body.replaceText("<<DIA_DES-LAB>>", "0"); body.replaceText("<<ASIG_D_LAB>>", "0,00");
  body.replaceText("<<CANT_FERIA>>", "0"); body.replaceText("<<ASIG_FERIA>>", "0,00");
  body.replaceText("<<DIA_INASIST>>", "0"); body.replaceText("<<TOTAL_SALARIO>>", datos.utilidadAsig);
  body.replaceText("<<BONO_ASIST>>", "0,00");
  body.replaceText("<<BONO_TRANSP>>", "0,00");
  body.replaceText("<<BONO_GUERRA>>", "0,00");
  
  var searchResult = body.findText("<<NOMBRE_BONO_UNICO>>");
  if (searchResult) {
    var tableRow = searchResult.getElement().getParent().getParent().getParent();
    if (tableRow.getType() === DocumentApp.ElementType.TABLE_ROW) {
      tableRow.removeFromParent();
    }
  }
  
  body.replaceText("<<TOTAL_BONOS>>", "0,00");
  body.replaceText("<<DED_SSO>>", datos.incesBs); 
  body.replaceText("<<DED_FAOV>>", "0,00");
  body.replaceText("<<DED_PIDE>>", "0,00");
  body.replaceText("<<TOTAL_ASIG>>", datos.utilidadAsig);
  body.replaceText("<<TOTAL_DED>>", datos.incesBs);
  body.replaceText("<<NETO_PAGAR>>", datos.totalPagar);
}
