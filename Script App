    '  <p id="progress-count" style="font-size: 12px; color: #666; margin: 8px 0 0 0; font-weight: bold;"></p>' +
    '</div>' +
    
    '<div id="step-3" style="font-family: Arial, sans-serif; padding: 25px 15px; text-align: center; display: none;">' +
    '  <h2 style="color: #0f9d58; margin-top: 0;">¡Completado!</h2>' +
    '  <p style="font-size: 14px; color: #333;">Se generaron todos los recibos.</p>' +
    '  <button class="btn btn-generar" onclick="google.script.host.close()">Cerrar Ventana</button>' +
    '</div>' +
    
    '<script>' +
    '  var listaEmpleados = [];' +
    '  var currentIndex = 0;' +
    '  var tipoDocumento = "' + tipo + '";' +
    '  ' +
    '  function iniciarProcesoMasivo() {' +
    '    document.getElementById("step-1").style.display = "none";' +
    '    document.getElementById("step-2").style.display = "block";' +
    '    google.script.run' +
    '      .withSuccessHandler(function(empleados) { listaEmpleados = empleados; procesarSiguiente(); })' +
    '      .withFailureHandler(function(error) { alert("Error: " + error.message); google.script.host.close(); })' +
    '      .getListaEmpleados();' +
    '  }' +
    '  ' +
    '  function procesarSiguiente() {' +
    '    if (currentIndex >= listaEmpleados.length) {' +
    '      document.getElementById("step-2").style.display = "none";' +
    '      document.getElementById("step-3").style.display = "block";' +
    '      return;' +
    '    }' +
    '    var nombre = listaEmpleados[currentIndex];' +
    '    document.getElementById("progress-text").innerHTML = "Generando documento de:<br><b>" + nombre + "</b>";' +
    '    document.getElementById("progress-count").innerHTML = "Procesando " + (currentIndex + 1) + " de " + listaEmpleados.length;' +
    '    ' +
    '    google.script.run' +
    '      .withSuccessHandler(function() { currentIndex++; procesarSiguiente(); })' +
    '      .withFailureHandler(function(error) { alert("Hubo un error con " + nombre + ": " + error.message); google.script.host.close(); })' +
    '      .procesarReciboServidor(nombre, tipoDocumento);' +
    '  }' +
    '</script>';
    
  var htmlOutput = HtmlService.createHtmlOutput(htmlContent).setWidth(360).setHeight(190);
  SpreadsheetApp.getUi().showModalDialog(htmlOutput, titulo);
}

// ==========================================
// VENTANAS MODALES PARA GENERACIÓN INDIVIDUAL
// ==========================================
function mostrarSelectorEmpleadoPago() { crearModalIndividual('pago', 'Recibo de Pago'); }
function mostrarSelectorEmpleadoCesta() { crearModalIndividual('cesta', 'Recibo de Cestaticket'); }

function crearModalIndividual(tipo, titulo) {
  var sheet = SpreadsheetApp.getActiveSpreadsheet().getActiveSheet();
  var data = sheet.getDataRange().getValues();
  var empleados = [];
  
  for (var i = 2; i < data.length; i++) {
    if (data[i][0] && data[i][0] !== "") { empleados.push(data[i][0]); }
  }
  
  var optionsHtml = empleados.map(function(emp) { return '<option value="' + emp + '">' + emp + '</option>'; }).join('');
  
  var htmlContent = 
    '<style>' +
    '  .btn { border: none; padding: 8px 15px; border-radius: 4px; cursor: pointer; font-weight: bold; transition: all 0.2s ease; }' +
    '  .btn-cancelar { background-color: #f1f1f1; color: #333; margin-right: 10px; }' +
    '  .btn-generar { background-color: #1a73e8; color: white; }' +
    '  @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }' +
    '</style>' +
    
    '<div id="form-selector" style="font-family: Arial, sans-serif; padding: 15px;">' +
    '  <p style="font-size: 14px; color: #333; margin-bottom: 12px;">Selecciona el trabajador:</p>' +
    '  <select id="empleado" style="width: 100%; padding: 8px; border-radius: 4px; border: 1px solid #ccc; font-size: 14px; margin-bottom: 20px;">' +
    optionsHtml +
    '  </select>' +
    '  <div style="text-align: right;">' +
    '    <button class="btn btn-cancelar" onclick="google.script.host.close()">Cancelar</button>' +
    '    <button class="btn btn-generar" onclick="generar()">Generar PDF</button>' +
    '  </div>' +
    '</div>' +
    
    '<div id="mensaje-carga" style="font-family: Arial, sans-serif; padding: 30px 15px; text-align: center; display: none;">' +
    '  <div style="border: 4px solid #f3f3f3; border-top: 4px solid #1a73e8; border-radius: 50%; width: 35px; height: 35px; animation: spin 1s linear infinite; margin: 0 auto 15px auto;"></div>' +
    '  <p style="font-size: 14px; color: #333; font-weight: bold; margin: 0;">Generando documento...</p>' +
    '</div>' +
    
    '<script>' +
    'function generar() {' +
    '  var emp = document.getElementById("empleado").value;' +
    '  var tipoDoc = "' + tipo + '";' +
    '  document.getElementById("form-selector").style.display = "none";' +
    '  document.getElementById("mensaje-carga").style.display = "block";' +
    '  google.script.run' +
    '    .withSuccessHandler(function() { google.script.host.close(); })' +
    '    .withFailureHandler(function(error) { alert("Hubo un error: " + error.message); google.script.host.close(); })' +
    '    .generarReciboIndividualUI(emp, tipoDoc);' +
    '}' +
    '</script>';
    
  var htmlOutput = HtmlService.createHtmlOutput(htmlContent).setWidth(350).setHeight(170);
  SpreadsheetApp.getUi().showModalDialog(htmlOutput, 'Generar ' + titulo);
}

function generarReciboIndividualUI(nombreEmpleado, tipo) {
  procesarReciboServidor(nombreEmpleado, tipo);
  var nomDoc = (tipo === 'cesta') ? 'Cestaticket' : 'Recibo de Pago';
  SpreadsheetApp.getUi().alert('¡Proceso Finalizado!', 'El ' + nomDoc + ' de ' + nombreEmpleado + ' fue generado correctamente.', SpreadsheetApp.getUi().ButtonSet.OK);
}
