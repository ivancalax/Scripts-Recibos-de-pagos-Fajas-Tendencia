      }
    }
  } else {
    body.replaceText("<<NOMBRE_BONO_UNICO>>", nombreUnico);
    body.replaceText("<<ASIG_B_UNICO>>", montoUnico);
  }
  
  body.replaceText("<<TOTAL_BONOS>>", datos.totalBonos); 
  body.replaceText("<<CESTATICKET>>", datos.cestaTicket); 
  
