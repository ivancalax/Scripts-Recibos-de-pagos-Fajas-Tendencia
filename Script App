// ==========================================
// 5. MOTOR ÚNICO DE GENERACIÓN DE PDF
// ==========================================
function reemplazarEtiquetas(body, etiquetas) {
  // Si existe bono único en la plantilla y su monto es 0,00 o no tiene nombre, elimina la fila
  if (etiquetas.hasOwnProperty("<<NOMBRE_BONO_UNICO>>")) {
    if (etiquetas["<<ASIG_B_UNICO>>"] === "0,00" || etiquetas["<<NOMBRE_BONO_UNICO>>"] === "") {
      var match = body.findText("<<NOMBRE_BONO_UNICO>>");
      if (match) {
        var filaTabla = match.getElement().getParent().getParent().getParent();
        if (filaTabla.getType() === DocumentApp.ElementType.TABLE_ROW) filaTabla.removeFromParent();
      }
      delete etiquetas["<<NOMBRE_BONO_UNICO>>"];
      delete etiquetas["<<ASIG_B_UNICO>>"];
    }
  }

  // Reemplazo masivo en bucle
  for (var tag in etiquetas) {
    body.replaceText(tag, etiquetas[tag]);
  }
}

function procesarReciboServidor(nombreEmpleado, tipo) {
  var cfg = CONFIG_RECIBOS[tipo];
  if (!cfg) throw new Error("Tipo de recibo no válido: " + tipo);

  var sheet = SpreadsheetApp.getActiveSpreadsheet().getActiveSheet();
  var sheetName = sheet.getName();
  var data = sheet.getDataRange().getValues();

  var filaEmpleado = null;
  for (var i = 2; i < data.length; i++) {
    if (data[i][0] === nombreEmpleado) {
      filaEmpleado = data[i];
      break;
    }
  }
  if (!filaEmpleado) throw new Error("Empleado no encontrado: " + nombreEmpleado);

  var mainFolder = DriveApp.getFolderById(ID_CARPETA_PRINCIPAL);
  var carpetas = mainFolder.getFoldersByName(sheetName);
  var targetFolder = carpetas.hasNext() ? carpetas.next() : mainFolder.createFolder(sheetName);

  var docName = cfg.prefijo + nombreEmpleado + "_" + sheetName;
  var tempFile = DriveApp.getFileById(cfg.idPlantilla).makeCopy(docName, targetFolder);
  var tempDoc = DocumentApp.openById(tempFile.getId());
  var body = tempDoc.getBody();

  // Ejecuta el mapeador correspondiente al tipo de recibo y reemplaza etiquetas
  var etiquetas = cfg.mapear(filaEmpleado, data);
  reemplazarEtiquetas(body, etiquetas);

  // Duplicar el contenido (Original Empleador / Copia Trabajador)
  var totalHijos = body.getNumChildren();
  for (var j = 0; j < totalHijos; j++) {
    var copia = body.getChild(j).copy();
    var tipoEl = copia.getType();
    if (tipoEl == DocumentApp.ElementType.PARAGRAPH) body.appendParagraph(copia);
    else if (tipoEl == DocumentApp.ElementType.TABLE) body.appendTable(copia);
    else if (tipoEl == DocumentApp.ElementType.LIST_ITEM) body.appendListItem(copia);
  }

  tempDoc.saveAndClose();
  targetFolder.createFile(tempFile.getAs(MimeType.PDF)).setName(docName + ".pdf");
  tempFile.setTrashed(true);

  return true;
}

function getListaEmpleados() {
  var data = SpreadsheetApp.getActiveSpreadsheet().getActiveSheet().getDataRange().getValues();
  var empleados = [];
  for (var i = 2; i < data.length; i++) {
    if (data[i][0] && data[i][0] !== "") empleados.push(data[i][0]);
  }
  return empleados;
}

