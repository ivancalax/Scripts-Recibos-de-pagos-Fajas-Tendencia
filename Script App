  body.replaceText("<<DED_FAOV>>", datos.dedFAOV); 
  body.replaceText("<<DED_PIDE>>", datos.dedPide); 
  body.replaceText("<<TOTAL_DED>>", datos.totalDeducciones); 
  body.replaceText("<<NETO_PAGAR>>", datos.netoPagar); 
}

