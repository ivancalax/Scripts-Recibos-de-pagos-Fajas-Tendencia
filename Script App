function obtenerDatosDeFila(fila, textoPeriodo, textoPeriodoCesta, nombreBonoGlobal) {
  return {
    trabajador: fila[0],
    cedula: fila[1],
    fechaIngreso: formatearFecha(fila[2]),
    cargo: fila[3],
    
    // VARIABLES INTACTAS
    sueldoMensual: formatearMoneda(fila[8]),        // I
    sueldoDiario: formatearMoneda(fila[9]),         // J 
    diasDesc: formatearCantidad(fila[16]),          // Q
    cantFeriados: formatearCantidad(fila[17]),      // R
    
    // === NUEVA: DÍAS DESCONTADOS (INASISTENCIAS) ===
    diasInasistencia: formatearCantidad(fila[18]),  // S (18): DIA DESCONTADO
    
    cantHorasExtDiurnas: formatearCantidad(fila[19]), // T
    cantHorasExtNocturnas: formatearCantidad(fila[20]),// U
    diasDescLabCant: formatearCantidad(fila[21]),   // V
    diasLab: formatearCantidad(fila[22]),           // W
    asigDias: formatearMoneda(fila[24]),            // Y
    asigDesc: formatearMoneda(fila[26]),            // AA
    horasExtDiurnas: formatearMoneda(fila[28]),     // AC
    horasExtNocturnas: formatearMoneda(fila[30]),   // AE
    asigFeriados: formatearMoneda(fila[32]),        // AG
    asigDescLab: formatearMoneda(fila[34]),         // AI
    
    // BONOS
    bonoAsistencia: formatearMoneda(fila[37]),      // AL
    bonoGuerra: formatearMoneda(fila[40]),          // AO
    bonoTransporte: formatearMoneda(fila[43]),      // AR
    
    // BONO ÚNICO Y ESPECIAL
    nombreBonoUnico: nombreBonoGlobal,           // AS2 (Nombre Constante de la columna AS)
    montoBonoUnico: formatearMoneda(fila[45]),   // AT (45): BONO UNICO BOLIVARES
    
    // COLUMNAS CESTATICKET
    cantInasistCesta: formatearCantidad(fila[49]),  // AX (49): INASISTENCIA INJUSTIFICADA CESTATICKET
    dedInasistCesta: formatearMoneda(fila[50]),     // AY (50): INASISTENCIA INJUSTIFICADA CESTA BS
    cestaDiario: formatearMoneda(fila[52]),         // BA (52): CESTATICKET DIARIO BOLIVARES
    cesta30Dias: formatearMoneda(fila[53]),         // BB (53): CESTATICKET 30 DIAS BOLIVARES
    
    // DEDUCCIONES
    dedSSO: formatearMoneda(fila[60]),              // BI (60): SSO BS
    dedPide: formatearMoneda(fila[61]),             // BJ (61): PIDE BS
    dedFAOV: formatearMoneda(fila[70]),             // BS (70): BANAVIH BS 1%
    totalDeducciones: formatearMoneda(fila[71]),    // BT (71): TOTAL BS (Deducciones)
    
    // TOTALES FINALES
    totalSalario: formatearMoneda(fila[72]),        // BU (72): TOTAL SALARIO BS
    totalBonos: formatearMoneda(fila[74]),          // BW (74): TOTAL BONOS
    cestaTicket: formatearMoneda(fila[75]),         // BX (75): CESTATICKET
    totalGralAsignaciones: formatearMoneda(fila[76]),// BY (76): TOTAL A PAGAR BOLIVARES
    netoPagar: formatearMoneda(fila[77]),           // BZ (77): TOTAL CON DEDUCCIONES SIN CESTATICKET
    
    textoPeriodo: textoPeriodo,
    textoPeriodoCesta: textoPeriodoCesta
  };
}

