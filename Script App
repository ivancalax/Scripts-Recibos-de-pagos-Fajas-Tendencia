function procesarReciboUtilidadesServidor(nombreEmpleado) {
  var sheet = SpreadsheetApp.getActiveSpreadsheet().getActiveSheet();
  var sheetName = sheet.getName();
  var data = sheet.getDataRange().getValues();
  
  var textoPeriodo = "EJERCICIO FISCAL " + new Date().getFullYear();
  
  var filaEmpleado = null;
  for (var i = 2; i < data.length; i++) {
    if (data[i][0] === nombreEmpleado) {
      filaEmpleado = data[i];
      break;
    }
  }
  if (!filaEmpleado) throw new Error("Empleado no encontrado: " + nombreEmpleado);

  var templateFile = DriveApp.getFileById(ID_PLANTILLA_UTILIDADES);
  var mainFolder = DriveApp.getFolderById(ID_CARPETA_PRINCIPAL);
  
  var targetFolder = mainFolder.getFoldersByName(sheetName).hasNext() ? mainFolder.getFoldersByName(sheetName).next() : mainFolder.createFolder(sheetName);

  var datos = obtenerDatosUtilidadesDeFila(filaEmpleado, textoPeriodo);
  
  var docName = "ReciboUtilidades_" + nombreEmpleado + "_" + sheetName;
  var tempFile = templateFile.makeCopy(docName, targetFolder);
  var tempDoc = DocumentApp.openById(tempFile.getId());
  var body = tempDoc.getBody();
  
  reemplazarEtiquetasUtilidades(body, datos);
  
  // Duplicar el recibo (Copia Empleador / Trabajador)
  var elements = [];
  for (var j = 0; j < body.getNumChildren(); j++) {
    elements.push(body.getChild(j).copy());
  }
  for (var j = 0; j < elements.length; j++) {
    var el = elements[j];
    var type = el.getType();
    if (type == DocumentApp.ElementType.PARAGRAPH) body.appendParagraph(el);
    else if (type == DocumentApp.ElementType.TABLE) body.appendTable(el);
    else if (type == DocumentApp.ElementType.LIST_ITEM) body.appendListItem(el);
  }
  
  tempDoc.saveAndClose();
  
  var pdfBlob = tempFile.getAs(MimeType.PDF);
  targetFolder.createFile(pdfBlob).setName(docName + ".pdf");
  tempFile.setTrashed(true);
  
  return true;
}

