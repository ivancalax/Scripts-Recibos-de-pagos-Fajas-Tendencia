function obtenerDatosUtilidadesDeFila(fila, textoPeriodo) {
  return {
    trabajador: fila[0],                    // Columna A
    cedula: fila[1],                        // Columna B
    fechaIngreso: formatearFecha(fila[2]),  // Columna C
    cargo: fila[3],                         // Columna D
    
    salarioDiario: formatearMoneda(fila[8]),        // I (8): Salario diario
    mesesCumplidos: formatearCantidad(fila[10]),    // K (10): Meses cumplidos
    diasUtilidades: formatearCantidad(fila[11]),    // L (11): Días de utilidades
    utilidadAsig: formatearMoneda(fila[13]),        // N (13): Asignación / Total en Bs
    incesBs: formatearMoneda(fila[15]),             // P (15): Retención INCES Bs
    totalPagar: formatearMoneda(fila[25]),          // Z (25): Total a pagar Bs
    
    textoPeriodo: textoPeriodo                      // Ej: EJERCICIO FISCAL 2026
  };
}

