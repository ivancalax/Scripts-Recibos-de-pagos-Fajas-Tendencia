function abrirCarpeta() {
  var ui = SpreadsheetApp.getUi();
  var sheetName = SpreadsheetApp.getActiveSpreadsheet().getActiveSheet().getName();
  try {
    var mainFolder = DriveApp.getFolderById(ID_CARPETA_PRINCIPAL);
    var subcarpetas = mainFolder.getFoldersByName(sheetName);
    var folderUrl = subcarpetas.hasNext() ? subcarpetas.next().getUrl() : mainFolder.getUrl();

    var html = HtmlService.createHtmlOutput(
      '<div style="font-family: Arial, sans-serif; text-align: center; padding: 20px;">' +
      '<p style="font-size: 14px; color: #333;">Haz clic para ver los PDFs de <b>' + sheetName + '</b>:</p>' +
      '<a href="' + folderUrl + '" target="_blank" style="background-color: #1a73e8; color: white; padding: 10px 20px; text-decoration: none; border-radius: 5px; font-weight: bold; display: inline-block; margin-top: 15px;" onclick="setTimeout(function(){google.script.host.close()}, 500)">📁 Ir a Google Drive</a>' +
