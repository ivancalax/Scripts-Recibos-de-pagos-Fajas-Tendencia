  body.replaceText("<<BONO_GUERRA>>", datos.bonoGuerra); 
  body.replaceText("<<BONO_TRANSP>>", datos.bonoTransporte); 
  
  // === LÓGICA DINÁMICA DEL BONO ÚNICO ===
  var montoUnico = datos.montoBonoUnico;
  var nombreUnico = datos.nombreBonoUnico;
  
  if (montoUnico === "0,00" || nombreUnico === "") {
    var searchResult = body.findText("<<NOMBRE_BONO_UNICO>>");
