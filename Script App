  } catch (e) {
    ui.alert('Error', 'No se pudo acceder a la carpeta. Verifica el ID.', ui.ButtonSet.OK);
  }
}

// ==========================================
// 3. UTILIDADES DE FORMATO
// ==========================================
function formatearMoneda(valor) {
  if (valor === "" || valor === null || typeof valor === 'undefined') return "0,00";
  var num = (typeof valor === 'number') ? valor : parseFloat(valor.toString().trim().replace(/\./g, '').replace(',', '.'));
  if (isNaN(num)) return "0,00";
  var partes = num.toFixed(2).split('.');
  partes[0] = partes[0].replace(/\B(?=(\d{3})+(?!\d))/g, ".");
  return partes.join(',');
}

function formatearCantidad(valor) {
  if (valor === "" || valor === null || typeof valor === 'undefined') return "0";
  var num = (typeof valor === 'number') ? valor : parseFloat(valor.toString().replace(',', '.'));
  return isNaN(num) ? "0" : num.toString().replace('.', ',');
}

function formatearFecha(valor) {
  if (!valor) return "";
  if (valor instanceof Date) {
    return ("0" + valor.getDate()).slice(-2) + "/" + ("0" + (valor.getMonth() + 1)).slice(-2) + "/" + valor.getFullYear();
  }
  return valor.toString();
}

function formatearMesAno(valor) {
  if (!valor) return "";
  var meses = ["ENERO", "FEBRERO", "MARZO", "ABRIL", "MAYO", "JUNIO", "JULIO", "AGOSTO", "SEPTIEMBRE", "OCTUBRE", "NOVIEMBRE", "DICIEMBRE"];
  if (valor instanceof Date) return meses[valor.getMonth()] + " " + valor.getFullYear();
  var partes = valor.toString().trim().split("/");
  return (partes.length === 3) ? meses[parseInt(partes[1], 10) - 1] + " " + partes[2] : valor.toString();
}

